# PostgreSQL
POSTGRES_USER=badge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=badge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://badge:changeme@localhost:5432/badge

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=audio

# Caddy (TLS proxy)
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localhost

# Application
SECRET_KEY=changeme-generate-a-secure-random-key
DEBUG=false

# LLM provider (api_key only in env, never in yaml)
LLM_API_KEY=

# STT provider
STT_API_KEY=
